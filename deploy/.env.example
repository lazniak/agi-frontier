# Copy to the repo root as .env on the server. Never commit .env.
OPENROUTER_API_KEY=sk-or-v1-...
# Cheap model with JSON-schema support for page extraction; validated at startup against /api/v1/models
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# Web-search variant for the daily discovery pass (OpenRouter web plugin)
OPENROUTER_MODEL_ONLINE=google/gemini-3.1-flash-lite:online
LOG_LEVEL=info
DISCOVER=1
MAX_LLM_CALLS_PER_RUN=20
