# Copy to the repo root as .env on the server. Never commit .env.
OPENROUTER_API_KEY=sk-or-v1-...
# Cheap model with JSON-schema support for page extraction; validated at startup against /api/v1/models
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# Web-search variant for the daily discovery pass and the weekly researcher backfill (OpenRouter web plugin)
OPENROUTER_MODEL_ONLINE=google/gemini-3.1-flash-lite:online
LOG_LEVEL=info
DISCOVER=1
MAX_LLM_CALLS_PER_RUN=20

# Researcher (arena + backfill --incremental + eval; promote after gates). How often it runs is
# scaled to real traffic — see the cadence block below.
RESEARCH_CONCURRENCY=2
RESEARCH_MAX_CALLS=400
ARENA_ENABLED=1
BACKFILL_ENABLED=1
PROMOTE_MIN_RECALL=0.85
PROMOTE_MIN_PRECISION=0.95
PROMOTE_MIN_SCORE_RECALL=0.8

# Traffic-scaled research cadence (REDESIGN §12.8): weekly below 3 visitors/day, up to every 6 h
# at 100+. Monthly OpenRouter spend guard in USD — once the month-to-date estimate reaches it the
# cadence drops back to weekly and the site shows the run as capped. 0 disables the guard.
RESEARCH_MONTHLY_USD=60
# nginx access log the web container writes one line per /latest.json fetch to, shared through the
# `weblogs` volume (compose sets this; only override it if you move the mount). The worker counts
# daily unique visitors as per-day salted hashes and truncates the file — no address is stored.
TRAFFIC_LOG=/logs/traffic.log
