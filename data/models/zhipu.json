    {
      "id": "zhipu-glm-130b",
      "lab": "zhipu",
      "name": "GLM-130B",
      "family": "GLM",
      "date": "2022-08-01",
      "date_precision": "month",
      "status": "released",
      "announcement": {
        "url": "https://raw.githubusercontent.com/THUDM/GLM-130B/main/README.md",
        "title": "THUDM/GLM-130B GitHub README",
        "quote": "GLM-130B is an open bilingual (English & Chinese) bidirectional dense model with 130 billion parameters, pre-trained using the algorithm of General Language Model (GLM).",
        "retrieved_at": "2026-09-07T05:30:00Z",
        "verified": true,
        "verified_at": "2026-09-07T09:36:07Z",
        "note": "Weights were released for research access via an application form in Aug 2022 (commonly cited as Aug 4, 2022); this exact day is not confirmed by the GitHub README's own changelog (which starts at 2022.08.24, a later quantization update), so recorded at month precision. Training itself ran May 6 - Jul 3, 2022 per the paper (arXiv 2210.02414)."
      },
      "scores": [
        {
          "benchmark": "lambada",
          "value": 80.2,
          "config": "zero-shot",
          "reported_by": "official",
          "source": {
            "url": "https://ar5iv.labs.arxiv.org/html/2210.02414",
            "title": "GLM-130B: An Open Bilingual Pre-trained Model",
            "quote": "GLM-130B offers a record-high accuracy of 80.2% on zero-shot LAMBADA by outperforming both GPT-3 and PaLM 540B in Figure 2.",
            "retrieved_at": "2026-09-07T05:30:00Z",
            "verified": true,
            "verified_at": "2026-09-07T09:36:07Z",
            "note": "A companion table (Table 2) gives the more precise FP16 value 80.21, rounded to 80.2 in this prose sentence."
          }
        },
        {
          "benchmark": "mmlu",
          "value": 44.8,
          "config": "5-shot",
          "reported_by": "official",
          "source": {
            "url": "https://ar5iv.labs.arxiv.org/html/2210.02414",
            "title": "GLM-130B: An Open Bilingual Pre-trained Model",
            "quote": "It continues moving up as the training proceeds, achieving an accuracy of 44.8 when the training has to end (i.e., viewing 400B tokens in total).",
            "retrieved_at": "2026-09-07T05:30:00Z",
            "verified": true,
            "verified_at": "2026-09-07T09:36:07Z",
            "note": "Sentence follows 'GLM-130B's few-shot (5-shot) performance on MMLU approaches GPT-3 (43.9)...'; a companion table (Table 2) gives the more precise FP16 value 44.75, rounded to 44.8 in this prose sentence."
          }
        }
      ],
      "notes": "GLM-130B was Zhipu/Tsinghua's flagship open-weights model before ChatGLM-6B; MMLU and LAMBADA are the only two index/legacy benchmarks the paper reports in a form directly comparable to this dataset's basket (most other reported results are on Chinese-specific or held-out benchmarks)."
    },
    {
      "id": "zhipu-chatglm-6b",
      "lab": "zhipu",
      "name": "ChatGLM-6B",
      "family": "GLM",
      "date": "2023-03-14",
      "date_precision": "day",
      "status": "released",
      "announcement": {
        "url": "https://raw.githubusercontent.com/THUDM/GLM-130B/main/README.md",
        "title": "THUDM/GLM-130B GitHub README (changelog)",
        "quote": "[2023.03.14] We are happy to introduce ChatGLM, a bilingual dialogue language model based on GLM-130B, and its open-sourced version ChatGLM-6B which can be run under only 6GB GPU memory!",
        "retrieved_at": "2026-09-07T05:30:00Z",
        "verified": true,
        "verified_at": "2026-09-07T09:36:07Z"
      },
      "scores": [
        {
          "benchmark": "lmarena-text",
          "value": 995,
          "config": "text, style control",
          "reported_by": "maintainer",
          "source": {
            "url": "https://lmarena.ai/leaderboard/text",
            "title": "LMArena text leaderboard",
            "quote": "396 396 399 chatglm-6b Non-commercial 995 ±13 4,914",
            "retrieved_at": "2026-09-07T16:28:41Z",
            "verified": true,
            "verified_at": "2026-09-07T16:28:41Z"
          }
        }
      ],
      "notes": "ChatGLM-6B (6.2B parameters) was not Zhipu's largest model at the time — GLM-130B (130B) predates it by seven months — but GLM-130B was a research-access checkpoint requiring an 8-GPU server, with no public chat product. ChatGLM-6B was Zhipu's first publicly accessible flagship chat product (ran locally on a single consumer GPU, and via a public web demo). Recorded here as a timeline tick with no basket scores: the model's GitHub README does not report legacy-basket benchmark numbers for this checkpoint (only for its June 2023 successor, ChatGLM2-6B)."
    },
