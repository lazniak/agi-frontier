# AGI Frontier worker — environment.
# Copy to `worker/.env` (git-ignored) or set these in docker-compose.
# Every value below is optional except OPENROUTER_API_KEY, which only `poll`, `discover`
# and `backfill` need. `arena --dry-run`, `backfill --dry-run`, `validate`, `bundle`,
# `verify` and `poll --dry-run` work without it.

# ---------------------------------------------------------------- OpenRouter
# Required for `poll`, `discover` and `backfill`.
OPENROUTER_API_KEY=

# Extraction model. Cheap is fine: the prompt is one page and the output is small JSON,
# and every claim is re-checked against the page afterwards.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Model used by `discover` and the researcher (`backfill`), which need OpenRouter's
# web-search plugin. Defaults to "<OPENROUTER_MODEL>:online".
OPENROUTER_MODEL_ONLINE=

# Researcher-only model override; defaults to <OPENROUTER_MODEL_ONLINE>.
# RESEARCH_MODEL=

# Override only when proxying OpenRouter.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Sent as HTTP-Referer / X-Title on every OpenRouter call, and recorded in latest.json.
SITE_URL=https://agi.pablogfx.com
SITE_TITLE=AGI Frontier

# ---------------------------------------------------------------- researcher (backfill / arena / eval / promote)
# Max concurrent OpenRouter requests from the researcher (semaphore on the client).
RESEARCH_CONCURRENCY=2

# Per-run call budget for `backfill` (discovery + extractions). When it is spent the run
# stops cleanly and the next run resumes from the progress file.
RESEARCH_MAX_CALLS=400

# Weekly LMArena step inside `loop`, and the leaderboard URLs tried in order.
ARENA_ENABLED=1
# ARENA_URLS=https://lmarena.ai/leaderboard/text,https://lmarena.ai/leaderboard,https://huggingface.co/spaces/lmarena-ai/chatbot-arena-leaderboard

# Weekly `backfill --incremental` (120-day window) inside `loop`.
BACKFILL_ENABLED=1

# `promote` gates: the researcher is merged into data/models only when the last eval clears
# all three (see README, "gold → researched → eval → promote").
PROMOTE_MIN_RECALL=0.85
PROMOTE_MIN_PRECISION=0.95
PROMOTE_MIN_SCORE_RECALL=0.8

# Version stamped on researcher-written releases and in the bundle.
# RESEARCHER_VERSION=2.0.0

# USD per 1M tokens; when set they override the built-in price table used for the
# `researcher.budget` spend estimate in the bundle.
# OPENROUTER_PRICE_IN=
# OPENROUTER_PRICE_OUT=

# ---------------------------------------------------------------- paths
# Both default to the repo root, which is detected by walking up from worker/src.
# Relative values are resolved against the repo root.
DATA_DIR=
STATE_DIR=
# REPO_ROOT=   # only needed if auto-detection fails (unusual layouts)

# ---------------------------------------------------------------- scheduling
# `loop`: minutes between polls, with +/- 5 min of jitter. Failures back off
# exponentially up to 6 hours.
LOOP_INTERVAL_MINUTES=60

# Run `discover` (once per 24 h) from `loop`. Set to 0 to poll only.
DISCOVER=1

# ---------------------------------------------------------------- cost guard
# Hard cap on LLM calls per poll/discover run. Unchanged pages and already-seen items
# never reach the LLM at all; this bounds the worst case (e.g. a site-wide redesign).
MAX_LLM_CALLS_PER_RUN=20

# ---------------------------------------------------------------- HTTP
# Browser-like UA for lab sites. The r.jina.ai fallback always uses a plain bot UA —
# the reader answers 403 to browser User-Agents.
HTTP_USER_AGENT=
HTTP_TIMEOUT_MS=20000

# Reuse worker/.state/pages/*.txt across runs when younger than this.
# 0 (default) = fetch once per run and never reuse between runs.
PAGE_CACHE_TTL_MINUTES=0

# ---------------------------------------------------------------- git
# 1 = commit changed data/ and push to origin/main as the bot (CLAUDE.md allows the bot
# to write data/** directly). 0 = leave the working tree dirty for a human.
GIT_PUSH=0

# Deploy key for the push, e.g.
# GIT_SSH_COMMAND=ssh -i /run/secrets/agi_deploy_key -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new
GIT_SSH_COMMAND=

# ---------------------------------------------------------------- logging
# debug | info | warn | error. JSON lines on stdout.
LOG_LEVEL=info
